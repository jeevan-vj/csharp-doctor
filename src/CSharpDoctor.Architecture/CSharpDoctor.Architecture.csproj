<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CSharpDoctor.Architecture</RootNamespace>
    <AssemblyName>CSharpDoctor.Architecture</AssemblyName>
    <Description>Whole-solution architecture inspector for CSharp Doctor (namespace cycles, dead code).</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CSharpDoctor.Core\CSharpDoctor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
</Project>
