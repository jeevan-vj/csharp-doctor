<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Authors>Jeevan Wijerathna</Authors>
    <Company>CSharp Doctor</Company>
    <Product>CSharp Doctor</Product>
    <Copyright>Copyright © Jeevan Wijerathna</Copyright>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup Label="Shared NuGet metadata">
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jeevan-vj/csharp-doctor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jeevan-vj/csharp-doctor.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Label="SourceLink" Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Label="NuGet audit suppressions">
    <!--
      Microsoft.CodeAnalysis.Workspaces.MSBuild transitively references Microsoft.Build.Tasks.Core.
      Those MSBuild assemblies are compile-time only; at runtime MSBuildLocator binds to the installed
      SDK's MSBuild, so the flagged package is never loaded. Suppress this specific advisory only.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-h4j7-5rxr-p4wc" />
  </ItemGroup>
</Project>
